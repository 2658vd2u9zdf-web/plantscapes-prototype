  "contract_rule": "evaluation_payload uses the plant-side contract verbatim; evidence envelopes must not silently replace real_value with operational_value",
  "site_model": [
    "Site",
    "one boundary or reference",
    "one or more independently matchable zones",
    "field evidence per zone",
    "operational values per zone",
    "separate user corrections and survey replacements"
  ],
  "field_evidence_required": [
    "real_value",
    "operational_value",
    "operational_value_origin",
    "operational_value_confidence",
    "source_or_derivation_note",
    "source_ledger_reference",
    "spatial_scope",
    "temporal_scope",
    "verification_status"
  ],
  "allowed_operational_origins": [
    "site_survey",
    "user_confirmed_observation",
    "official_spatial_dataset",
    "official_regional_proxy",
    "documented_inference",
    "synthetic_fallback",
    "explicit_unknown"
  ],
  "origin_confidence": {
    "site_survey": 1.0,
    "user_confirmed_observation": 0.9,
    "official_spatial_dataset": 0.85,
    "official_regional_proxy": 0.65,
    "documented_inference": 0.5,
    "synthetic_fallback": 0.3,
    "explicit_unknown": 0.0
  },
  "spatial_scopes": [
    "exact site or polygon",
    "site zone",
    "nearby point",
    "neighbourhood",
    "municipality",
    "regional proxy",
    "synthetic demonstration profile",
    "synthetic canonical test fixture"
  ],
  "zone_scoring_fields": {
