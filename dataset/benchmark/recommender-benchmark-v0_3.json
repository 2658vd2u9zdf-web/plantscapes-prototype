        {"id": "B02-sun-only-is-conditional-not-conflict", "policy_basis": ["V03_RULES.compatibility_matrices.light"], "statement": "Sun-only plants under mixed light are adjacent (0.5), not a conflict.", "select": {"light_tolerance": {"equals": ["sun"]}}, "min_matches": 3, "expect": {"ratio_max": {"light": 0.5}, "ratio_min": {"light": 0.5}, "no_conflict_reason_for": ["light"]}},
