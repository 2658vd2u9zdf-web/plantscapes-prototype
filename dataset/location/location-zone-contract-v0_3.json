{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "0.3.0",
  "status": "pilot_only_not_production_ready",
  "authoritative_dependencies": {
    "plant_location_contract": {
      "path": "dataset/scoring/plant-location-contract-v0_3.json",
