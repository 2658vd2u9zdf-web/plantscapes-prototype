    },
    "soil": {
      "required": true,
      "unit": "categorical",
      "allowed_values": [
        "sand",
        "clay",
        "peat",
        "made",
        "unknown"
      ]
    },
    "moisture": {
      "required": true,
      "unit": "categorical",
      "allowed_values": [
        "dry",
        "fresh",
        "wet",
        "variable",
        "unknown"
      ]
    },
    "hydrology": {
      "required": true,
      "unit": "categorical",
      "allowed_values": [
        "none",
        "seasonal",
        "long",
        "permanent",
        "edge",
        "unknown"
      ]
    },
    "light": {
      "required": true,
      "unit": "categorical",
      "allowed_values": [
        "sun",
        "mixed",
        "shade",
        "unknown"
      ]
    },
    "canopy": {
      "required": true,
      "unit": "categorical",
      "allowed_values": [
        "yes",
        "no",
        "unknown"
      ]
    },
    "disturbance": {
      "required": true,
      "unit": "categorical",
      "allowed_values": [
        "low",
        "moderate",
        "high",
        "unknown"
      ]
    },
    "hardscape": {
      "required": true,
      "unit": "categorical",
      "allowed_values": [
        "yes",
        "no",
        "unknown"
      ]
    },
    "waterEdge": {
      "required": true,
      "unit": "categorical",
      "allowed_values": [
        "yes",
        "no",
        "unknown"
      ]
    },
    "source": {
      "required": true,
      "unit": "categorical",
      "allowed_values": [
        "demo",
        "observation",
        "survey",
        "document",
        "unverified",
        "unknown"
      ]
    },
    "path_edge": {
      "required": true,
      "unit": "categorical",
      "allowed_values": [
        "yes",
        "no",
        "unknown"
      ]
    },
    "available_width_m": {
      "required": true,
      "unit": "m",
