  "score_components": {
    "soil": {
      "weight": 15,
      "plant_fields": [
        "soil_tolerance"
      ],
      "site_or_project_fields": [
        "soil"
      ]
    },
    "moisture": {
      "weight": 20,
      "plant_fields": [
        "moisture_tolerance"
      ],
      "site_or_project_fields": [
        "moisture"
      ]
    },
    "hydrology": {
      "weight": 15,
      "plant_fields": [
        "hydrology_tolerance"
      ],
      "site_or_project_fields": [
        "hydrology"
      ]
    },
