{
  "benchmark_id": "plantscapes-recommender-benchmark",
  "version": "1.0.0",
  "created": "2026-10-20",
  "applies_to_rules": "dataset/scoring/plant-suitability-rules-v0_3.json",
  "status": "synthetic_policy_benchmark",
  "statement": "Every zone and project below is an explicitly synthetic test scenario, not a real site. Expectations encode existing project policy only: the v0.3 suitability rules and location contract, the plant/location pilot handovers and the approved planting rulebook v0.1.1 (dataset/planting-plan-rules.v0.1.json). They are not botanical ground truth and never assert that a plant is suitable for a real place. Adversarial variants change an in-memory copy of one record to exercise a gate; they are not plant facts.",
  "policy_sources": {
    "V03_RULES": "dataset/scoring/plant-suitability-rules-v0_3.json",
    "V03_HANDOVER": "dataset/PLANT-DATA-PILOT-HANDOVER-v0.3.md (Suitability and confidence specification)",
    "V03_CONTRACT": "dataset/scoring/plant-location-contract-v0_3.json",
    "RULEBOOK": "dataset/planting-plan-rules.v0.1.json (approved design policy, review_state design_policy_approved_species_validation_pending)"
  },
  "expectation_language": {
    "select": "Plant selector over operational record fields. Scalar = equality; {includes|lacks: v} for arrays; {in|not_in: [..]}; {gt|lte: n}; {equals: [..]} for exact arrays. Empty selector = all 60 records.",
    "adversarial": "Selects only the named in-memory adversarial variant instead of real records.",
    "min_matches": "The selector must match at least this many records so an expectation can never pass vacuously.",
    "expect": "state_in, state_not_in, eligible, gate {gate_id: state|[states]}, final_max, final_equals, warning [codes], warning_absent [codes], cap [rules], cap_absent [rules], ratio_max {component: n}, ratio_min {component: n}, conflict_reason_for [site fields], no_conflict_reason_for [site fields], quantity_state_in, quantity_within_zone_area, quantity_support_floor, footprint_state_in, visibility_state_in, invariant_under {zone|project changes, fields}, lower_than_under {zone|project changes, field}."
  },
  "scenarios": [
    {
      "id": "B01_dry_sunny_sand",
      "title": "Dry, sunny sandy planting",
      "zone": {"zone_id": "B01_dry_sunny_sand", "soil": "sand", "moisture": "dry", "hydrology": "none", "light": "sun", "canopy": "no", "disturbance": "low", "hardscape": "no", "waterEdge": "no", "source": "demo", "path_edge": "no", "available_width_m": 20, "available_length_m": 15, "plantable_area_m2": 300, "max_plant_height_m": "unknown", "support_length_m": "unknown"},
      "project": {"type": "landscape", "area": 1000, "maintenance": "moderate", "publicAccess": true, "publicHarvest": false, "sightlines": false, "rewilding": false, "support": false, "character": "mosaic", "restorationOrnamentals": false, "vigourControl": "no", "evaluation_stage": "candidate", "anchorColours": ["purple", "yellow"], "desiredFlowerMonths": [6, 7, 8], "priorities": ["pollinators"]},
      "expectations": [
        {"id": "B01-soil-conflict", "policy_basis": ["V03_RULES.environmental_conflict_rule"], "statement": "A known soil mismatch caps the plant at 49 and is reported as an environmental conflict, never hidden by other components.", "select": {"soil_tolerance": {"lacks": "sand"}}, "min_matches": 5, "expect": {"state_in": ["unsuitable", "excluded"], "final_max": 49, "eligible": false, "conflict_reason_for": ["soil"]}},
        {"id": "B01-wet-only-moisture-conflict", "policy_basis": ["V03_RULES.environmental_conflict_rule"], "statement": "Wet-only moisture tolerance on dry ground is a known conflict.", "select": {"moisture_tolerance": {"equals": ["wet"]}}, "min_matches": 3, "expect": {"state_in": ["unsuitable", "excluded"], "eligible": false, "conflict_reason_for": ["moisture"]}},
        {"id": "B01-required-edge", "policy_basis": ["H03_WATER_EDGE"], "statement": "Plants whose operational record requires a water edge are excluded on dry ground without a confirmed edge.", "select": {"water_edge_requirement": "required"}, "min_matches": 3, "expect": {"gate": {"H03_WATER_EDGE": "excluded"}, "final_equals": 0}},
        {"id": "B01-public-cap", "policy_basis": ["H06_PUBLIC_CONTACT", "V03_RULES.final_score_caps.unreviewed_public_contact", "RULEBOOK.W02"], "statement": "Unreviewed public-contact status is unresolved, never safe: every record requires review and stays at or below 59.", "select": {}, "min_matches": 60, "expect": {"gate": {"H06_PUBLIC_CONTACT": "requires_review"}, "final_max": 59, "state_not_in": ["suitable", "strong_match"]}},
        {"id": "B01-matched-herbs-conditional", "policy_basis": ["V03_HANDOVER"], "statement": "Herbaceous records whose operational tolerances include every zone category remain conditional demonstration candidates (policy review still outstanding).", "select": {"soil_tolerance": {"includes": "sand"}, "moisture_tolerance": {"includes": "dry"}, "light_tolerance": {"includes": "sun"}, "hydrology_tolerance": {"includes": "none"}, "water_edge_requirement": {"not_in": ["required"]}, "group": {"in": ["Flowers & herbs", "Grasses, sedges & rushes"]}}, "min_matches": 5, "expect": {"state_in": ["conditional_match"], "eligible": true}},
        {"id": "B01-design-preference-is-tie-break-only", "policy_basis": ["V03_RULES.design_preference", "V03_HANDOVER"], "statement": "Changing colour, month and pollinator preferences never changes raw/final suitability, state or gates.", "select": {}, "min_matches": 60, "expect": {"invariant_under": {"project": {"anchorColours": ["white"], "desiredFlowerMonths": [1, 2], "priorities": []}, "fields": ["raw_suitability_score", "final_suitability_score", "eligibility_state", "hard_gate_results"]}}},
        {"id": "B01-native-first-ordering", "policy_basis": ["RULEBOOK.first_release_policy.native_policy", "RULEBOOK.G05", "V03_HANDOVER (unknown never native)"], "statement": "When final and raw suitability tie, records with sourced native status are listed before records whose native status is unknown; colour or month preference cannot lift an unknown-native record above them.", "ranking": {"known_native_before_unknown_at_equal_suitability": true}}
      ]
    },
