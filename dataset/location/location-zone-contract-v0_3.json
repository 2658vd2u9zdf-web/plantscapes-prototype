      "weight": 10,
      "plant_fields": [
        "maintenance_demand",
        "vigour_or_spread_risk"
      ],
      "site_or_project_fields": [
        "maintenance",
        "vigourControl"
      ]
    }
  },
  "hard_gates": {
    "H01_IDENTITY": "Unknown scientific identity or plant_id excludes.",
    "H02_INVASIVE_LEGAL": "Any explicit positive invasive status (listed_nl, listed_eu, invasive_elsewhere) or legally_prohibited excludes; unknown/nonlisting never clears. Foreign weediness alone is not assigned an invasive status.",
    "H03_WATER_EDGE": "Required edge demands waterEdge=yes AND hydrology seasonal|long|permanent|edge.",
    "H04_PERMANENT_WATER": "Permanent zone excludes plant lacking explicit operational permanent tolerance. Unknown hydrology requires review for such a plant: permanent water is not ruled out and the plant is never treated as hydrologically compatible.",
    "H05_SUPPORT": "Climbing support required but support=false excludes.",
    "H06_PUBLIC_CONTACT": "Public access and known unsuitable public contact excludes.",
    "H07_WOODY_GEOMETRY": "Tree/shrub cannot fit full spread square and area: exclusion at placement, unsuitable candidate. A known misfit at candidate stage and unknown geometry require review; neither reads as passed.",
    "H08_VIGOUR": "Low maintenance plus high vigour and no explicit active control excludes; control=yes conditional. High vigour with unknown maintenance capacity (and no declared control) requires review.",
    "H09_NATIVE_POLICY": "Rewilding known introduced excludes. Unknown native in rewilding caps final at 54.",
    "H10_RESTORATION_POLICY": "Restoration known introduced needs explicit ornamental override. With the override it requires review and is disclosed by warning restoration_ornamental_exception (rulebook G05). Unknown native status in restoration requires review.",
    "H11_PATH_THORNS": "Known thorns/prickles at path edge excludes placement. Known thorns at a mapped path edge during candidate screening, or where path-edge context is unknown, require review. Unknown thorns never clear public-contact use.",
    "H12_MAINTENANCE_CAPACITY": "Approved rulebook W03: known maintenance demand above project capacity (demand ratio 0) or unknown capacity requires review/plan revision. It never excludes and never changes points in v0.3.1; whether it should cap or exclude is an open policy question."
  },
  "score_weight_total": 100,
  "confidence_rule": "Evidence confidence is independent of suitability. Compatibility is never inferred from confidence, and unknown has zero evidence confidence.",
  "canopy_rule": "Context only; no independent effect or doubled light points.",
  "dynamic_update_rule": "Preserve original suggestion, append user correction or survey replacement with timestamp and actor/basis, recompute operational value, and flag stale evidence without deleting history.",
  "non_goals": [
    "no website integration",
    "no citywide environmental truth",
    "no production planting advice",
    "no safety or legal decision on the location side"
  ]
}
