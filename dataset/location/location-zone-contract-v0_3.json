    "available_length_m": {
      "required": true,
      "unit": "m",
      "value_rule": "non-negative number or literal unknown; pilot fixtures resolve to a number"
    },
    "plantable_area_m2": {
      "required": true,
      "unit": "m2",
      "value_rule": "non-negative number or literal unknown; pilot fixtures resolve to a number"
    },
